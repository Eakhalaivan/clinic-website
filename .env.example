# ──────────────────────────────────────────────────────────
# clinic-website — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────────────────

# ── Databases (Clinic & Pharmacy) ────────────────────────
# Clinic Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/clinic?sslmode=disable
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_PASSWORD=postgres

# Pharmacy Database (MySQL)
PHARMACY_DB_URL=jdbc:mysql://localhost:3306/pharmacy?useSSL=false&allowPublicKeyRetrieval=true
PHARMACY_DB_USER=root
PHARMACY_DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# Supabase (Optional Remote DB config)
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# ── Supabase Public Keys (used by the frontend) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ── JWT ──────────────────────────────────────────────────
# Minimum 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_min_32_chars_hex_256bit

# ── Twilio (SMS / MFA) ───────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# ── SMTP (email notifications) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# ── Frontend / CORS ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
ALLOWED_ORIGINS=http://localhost:5173

# ── Data Seeder (dev only) ───────────────────────────────
# Used by DataSeeder.java to create initial admin/doctor accounts.
# App will REFUSE to start if these are still set to CHANGE_ME_*.
SEED_ADMIN_PASSWORD=your_secure_admin_seed_password_here
SEED_DOCTOR_PASSWORD=your_secure_doctor_seed_password_here

# ── find_region.sh ───────────────────────────────────────
# Required when running find_region.sh — never hardcode in the script.
SUPABASE_PROJECT_ID=your-project-id
# PGPASSWORD is the same as SUPABASE_DB_PASSWORD above.
